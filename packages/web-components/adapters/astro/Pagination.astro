---
/** Astro adapter for <plt-pagination>; the fallback is the same list of links. */
import type { PltPage, PltPaginationLabels } from "../../dist/collection/index.js";

interface Props {
  pages: PltPage[];
  previousUrl?: string;
  nextUrl?: string;
  labels?: PltPaginationLabels;
  /** Content-sized buttons in one joined row (numbered store pagination). */
  compact?: boolean;
  /** URL fragment appended to every link, e.g. `#Comments-123`. */
  anchor?: string;
  id?: string;
  class?: string;
}

const { pages: rawPages, previousUrl: rawPreviousUrl, nextUrl: rawNextUrl, labels = {}, compact = false, anchor = "", id, class: className } = Astro.props;
const pages = anchor ? rawPages.map((page) => (page.url ? { ...page, url: page.url + anchor } : page)) : rawPages;
const previousUrl = rawPreviousUrl && rawPreviousUrl + anchor;
const nextUrl = rawNextUrl && rawNextUrl + anchor;
---

<plt-pagination
  id={id}
  class={className}
  variant={compact ? "compact" : undefined}
  pages={JSON.stringify(pages)}
  previous-url={previousUrl}
  next-url={nextUrl}
  labels={JSON.stringify(labels)}
>
  <nav data-plt-fallback aria-label={labels.nav ?? "Pagination"}>
    {previousUrl && <a href={previousUrl}>{labels.previous ?? "Previous"}</a>}
    {pages.map((page) =>
      page.url && !page.current ? <a href={page.url}>{page.label}</a> : <span aria-current={page.current ? "page" : undefined}>{page.label}</span>,
    )}
    {nextUrl && <a href={nextUrl}>{labels.next ?? "Next"}</a>}
  </nav>
</plt-pagination>

<script>
  import "../../dist/collection/define.js";
</script>
