{% doc %}
  Liquid adapter for the Newsletter signup card. The theme supplies the form action (for example a Shopify customer form) and any hidden fields through `form_action`.
  Self-contained: it renders no other snippet and needs no
  JavaScript (the markup is styled by @playlovetoys/design-system).

  @param {string} heading - Card heading
  @param {string} [body] - Supporting text
  @param {string} [form_action] - Form action (default: #)
  @param {string} [method] - Form method (default: post)
  @param {string} [input_name] - Email field name (default: email)
  @param {string} [input_placeholder] - Placeholder (default: Email address)
  @param {string} [action_label] - Submit label (default: Subscribe)
{% enddoc %}
{% comment %} GENERATED by packages/web-components/scripts/build-static-adapters.mjs from packages/design-system/renderers/liquid/newsletter.liquid. Edit the renderer, then run `npm run build:adapters`. {% endcomment %}
<section class="plt-newsletter">
  <div class="d-card bg-base-100 theme-bordered theme-elevated plt-newsletter__card">
    <div class="d-card-body plt-newsletter__content">
      <h2 class="d-card-title theme-headline-lg">{{ heading | escape }}</h2>
      {% if body != blank %}<p class="theme-body-lg">{{ body | escape }}</p>{% endif %}
      <form class="plt-newsletter__form" action="{{ form_action | default: '#' | escape }}" method="{{ method | default: 'post' | escape }}">
        <input
          class="d-input"
          type="email"
          name="{{ input_name | default: 'email' | escape }}"
          placeholder="{{ input_placeholder | default: 'Email address' | escape }}"
          required
        >
        <button class="d-btn d-btn-primary theme-bordered theme-elevated theme-label-bold" type="submit">{{ action_label | default: 'Subscribe' | escape }}</button>
      </form>
    </div>
  </div>
</section>
