{% doc %}
  Liquid adapter for the EditorialCard (article / blog card). Normalized text inputs are escaped.
  Self-contained: it renders no other snippet and needs no
  JavaScript (the markup is styled by @playlovetoys/design-system).

  @param {string} title - Card title
  @param {string} url - Article URL
  @param {string} [image_url] - Cover image URL
  @param {string} [image_alt] - Image alt (default: title)
  @param {string} [meta] - Meta line (date, author, …)
  @param {string} [excerpt] - Short description
  @param {string} [action_label] - Link label (default: Read more)
{% enddoc %}
{% comment %} GENERATED by packages/web-components/scripts/build-static-adapters.mjs from packages/design-system/renderers/liquid/editorial-card.liquid. Edit the renderer, then run `npm run build:adapters`. {% endcomment %}
<article class="d-card bg-base-100 theme-bordered theme-elevated plt-media-card plt-editorial-card">
  {% if image_url != blank %}
    <a class="plt-media-card__media" href="{{ url | escape }}">
      <img src="{{ image_url | escape }}" alt="{{ image_alt | default: title | escape }}" loading="lazy">
    </a>
  {% endif %}
  <div class="d-card-body plt-media-card__body">
    <h2 class="d-card-title theme-headline-sm plt-media-card__title">
      <a href="{{ url | escape }}">{{ title | escape }}</a>
    </h2>
    {% if meta != blank %}<p class="theme-meta plt-media-card__meta">{{ meta | escape }}</p>{% endif %}
    {% if excerpt != blank %}<p class="theme-body-lg plt-media-card__description">{{ excerpt | escape }}</p>{% endif %}
    <div class="d-card-actions plt-media-card__actions">
      <a class="d-btn d-btn-ghost theme-label-bold" href="{{ url | escape }}">{{ action_label | default: 'Read more' | escape }}</a>
    </div>
  </div>
</article>
