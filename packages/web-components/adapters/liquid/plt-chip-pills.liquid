{% doc %}
  Liquid adapter for the ChipPills: a nav of badge links.
  Self-contained: it renders no other snippet and needs no
  JavaScript (the markup is styled by @playlovetoys/design-system).

  @param {object[]} items - [{ label, url, current? }]
{% enddoc %}
{% comment %} GENERATED by packages/web-components/scripts/build-static-adapters.mjs from packages/design-system/renderers/liquid/chip-pills.liquid. Edit the renderer, then run `npm run build:adapters`. {% endcomment %}
<nav class="plt-chip-pills" aria-label="Pills">
  {% for item in items %}
    <a
      class="d-badge theme-bordered{% if item.current %} d-badge-primary{% else %} d-badge-outline{% endif %}"
      href="{{ item.url | escape }}"
      {% if item.current %}aria-current="page"{% endif %}
    >{{ item.label | escape }}</a>
  {% endfor %}
</nav>
