{% doc %}
  Liquid adapter for the TrustBar: a row of reassurance items. `icon` is pre-sanitized HTML.
  Self-contained: it renders no other snippet and needs no
  JavaScript (the markup is styled by @playlovetoys/design-system).

  @param {object[]} items - [{ icon?, label, body? }]
  @param {string} [heading] - Section heading
{% enddoc %}
{% comment %} GENERATED by packages/web-components/scripts/build-static-adapters.mjs from packages/design-system/renderers/liquid/trust-bar.liquid. Edit the renderer, then run `npm run build:adapters`. {% endcomment %}
<section class="plt-trust-bar">
  {% if heading != blank %}<h2 class="theme-headline-lg">{{ heading | escape }}</h2>{% endif %}
  <ul class="plt-trust-bar__list">
    {% for item in items %}
      <li class="plt-trust-bar__item theme-bordered theme-elevated">
        {% if item.icon != blank %}<div class="plt-trust-bar__icon">{{ item.icon }}</div>{% endif %}
        <h3 class="theme-label-bold plt-trust-bar__label">{{ item.label | escape }}</h3>
        {% if item.body != blank %}<p class="theme-meta">{{ item.body | escape }}</p>{% endif %}
      </li>
    {% endfor %}
  </ul>
</section>
