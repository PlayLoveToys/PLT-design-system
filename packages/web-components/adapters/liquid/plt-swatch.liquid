{% doc %}
  Liquid adapter for the Swatch: a colour chip or a small image.
  Self-contained: it renders no other snippet and needs no
  JavaScript (the markup is styled by @playlovetoys/design-system).

  @param {string} [color] - CSS colour value
  @param {string} [image_url] - Image URL
  @param {string} [image_alt] - Image alt (default: label)
  @param {string} [label] - Accessible name
  @param {string} [size] - sm or md (default)
{% enddoc %}
{% comment %} GENERATED by packages/web-components/scripts/build-static-adapters.mjs from packages/design-system/renderers/liquid/swatch.liquid. Edit the renderer, then run `npm run build:adapters`. {% endcomment %}
{%- liquid
  assign swatch_class = 'plt-swatch'
  if size == 'sm'
    assign swatch_class = swatch_class | append: ' plt-swatch--sm'
  endif
-%}
<span
  class="{{ swatch_class }}"
  {% if color != blank %}style="background-color: {{ color | escape }};"{% endif %}
  {% if label != blank %}role="img" aria-label="{{ label | escape }}"{% endif %}
>
  {% if image_url != blank %}
    <img src="{{ image_url | escape }}" alt="{{ image_alt | default: label | escape }}">
  {% endif %}
</span>
