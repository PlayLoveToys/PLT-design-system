{% doc %}
  Liquid adapter for the CollectionCard (media card linking to a collection).
  Self-contained: it renders no other snippet and needs no
  JavaScript (the markup is styled by @playlovetoys/design-system).

  @param {string} title - Collection title
  @param {string} url - Collection URL
  @param {string} [image_url] - Image URL
  @param {string} [image_alt] - Image alt (default: title)
  @param {string} [description] - Short description
{% enddoc %}
{% comment %} GENERATED by packages/web-components/scripts/build-static-adapters.mjs from packages/design-system/renderers/liquid/collection-card.liquid. Edit the renderer, then run `npm run build:adapters`. {% endcomment %}
<a href="{{ url | escape }}" class="d-card bg-base-100 theme-bordered theme-elevated plt-media-card plt-collection-card">
  {% if image_url != blank %}
    <figure class="plt-media-card__media plt-collection-card__media">
      <img src="{{ image_url | escape }}" alt="{{ image_alt | default: title | escape }}" loading="lazy">
    </figure>
  {% endif %}
  <div class="d-card-body plt-media-card__body">
    <h2 class="d-card-title theme-headline-sm plt-media-card__title">{{ title | escape }}</h2>
    {% if description != blank %}<p class="theme-meta plt-media-card__description">{{ description | escape }}</p>{% endif %}
  </div>
</a>
