{% doc %}
  Liquid adapter for the LinkGrid: link columns.
  Self-contained: it renders no other snippet and needs no
  JavaScript (the markup is styled by @playlovetoys/design-system).

  @param {object[]} columns - [{ title?, links: [{ label, url }] }]
  @param {string} [heading] - Section heading
{% enddoc %}
{% comment %} GENERATED by packages/web-components/scripts/build-static-adapters.mjs from packages/design-system/renderers/liquid/link-grid.liquid. Edit the renderer, then run `npm run build:adapters`. {% endcomment %}
<section class="plt-link-grid">
  {% if heading != blank %}<h2 class="theme-headline-lg">{{ heading | escape }}</h2>{% endif %}
  <div class="plt-link-grid__columns">
    {% for column in columns %}
      <div class="plt-link-grid__column">
        {% if column.title != blank %}
          <h3 class="theme-headline-sm theme-headline-underline">{{ column.title | escape }}</h3>
        {% endif %}
        <ul class="d-menu">
          {% for link in column.links %}
            <li><a class="theme-label-bold" href="{{ link.url | escape }}">{{ link.label | escape }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>
</section>
