{
  "name": "@playlovetoys/design-system",
  "version": "0.7.0",
  "private": true,
  "description": "Portable visual foundations, primitives, composite patterns and cross-platform renderers for Play, love & Toys.",
  "type": "module",
  "scripts": {
    "build:demo": "tailwindcss -i ./demo/demo.css -o ./demo/dist.css --minify",
    "check:conformance": "node scripts/check-daisyui-conformance.mjs",
    "check:renderers": "node scripts/check-renderer-safety.mjs",
    "check:contracts": "node scripts/check-commerce-contracts.mjs",
    "test": "vitest run",
    "check": "npm run check:conformance && npm run check:renderers && npm run check:contracts && npm run test && npm run check:css && npm run check:themes && npm run build:demo && npm run build:themes",
    "build:themes": "node scripts/build-themes.mjs",
    "check:css": "stylelint \"src/patterns.css\" \"src/primitives.css\" \"src/typography.css\" \"src/base.css\" \"src/utilities.css\" \"src/geometry.css\" \"src/components/*.css\"",
    "check:themes": "node scripts/check-theme-rules.mjs"
  },
  "files": [
    "src",
    "themes",
    "adapters",
    "contracts",
    "renderers",
    "demo",
    "docs",
    "DESIGN.md"
  ],
  "exports": {
    ".": "./src/index.css",
    "./tokens": "./src/tokens.css",
    "./tokens/*": "./src/tokens/*",
    "./typography": "./src/typography.css",
    "./geometry": "./src/geometry.css",
    "./utilities": "./src/utilities.css",
    "./primitives": "./src/primitives.css",
    "./patterns": "./src/patterns.css",
    "./variant-picker": "./src/components/variant-picker.css",
    "./web-components": "./src/components/web-components.css",
    "./mega-menu": "./src/components/mega-menu.css",
    "./product-review-stars": "./src/components/product-review-stars.css",
    "./predictive-search": "./src/components/predictive-search.css",
    "./bento-grid": "./src/components/bento-grid.css",
    "./theme-group": "./src/components/theme-group.css",
    "./marquee": "./src/components/marquee.css",
    "./blog": "./src/components/blog.css",
    "./article": "./src/components/article.css",
    "./daisyui": "./src/daisyui-theme.css",
    "./shopify": "./adapters/shopify.css",
    "./astro": "./adapters/astro.css",
    "./contracts": "./contracts/components.md",
    "./renderers/liquid/*": "./renderers/liquid/*",
    "./renderers/astro/*": "./renderers/astro/*",
    "./base": "./src/base.css",
    "./scoped-preflight": "./src/scoped-preflight.css",
    "./themes/*": "./themes/*.css"
  },
  "peerDependencies": {
    "daisyui": ">=5.7.8 <6",
    "tailwindcss": ">=4 <5"
  },
  "devDependencies": {
    "@tailwindcss/cli": ">=4 <5",
    "daisyui": ">=5.7.8 <6",
    "jsdom": "^29.1.1",
    "stylelint": "^17.16.0",
    "tailwindcss": ">=4 <5",
    "vitest": "^3.2.4"
  }
}
