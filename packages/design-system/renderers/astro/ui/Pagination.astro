---
interface PageItem {
  label: string;
  url?: string;
  current?: boolean;
  disabled?: boolean;
}

interface Props {
  pages: PageItem[];
  ariaLabel?: string;
  prevUrl?: string;
  nextUrl?: string;
  prevLabel?: string;
  nextLabel?: string;
  compact?: boolean;
  /** Optional URL fragment appended to every link (e.g. '#Comments-123'). */
  anchor?: string;
}

const {
  pages,
  ariaLabel = "Pagination",
  prevUrl,
  nextUrl,
  prevLabel = "Previous",
  nextLabel = "Next",
  compact = false,
  anchor = "",
} = Astro.props;

const withAnchor = (url?: string) => (url ? `${url}${anchor}` : url);
const prev = withAnchor(prevUrl);
const next = withAnchor(nextUrl);
---

<nav class:list={["plt-pagination", { "plt-pagination--compact": compact }]} aria-label={ariaLabel}>
  <div class="d-join">
    {prev ? (
      <a class="d-btn d-btn-outline d-join-item theme-bordered theme-label-bold" href={prev}>{prevLabel}</a>
    ) : (
      <button class="d-btn d-btn-outline d-join-item theme-bordered d-btn-disabled" type="button" disabled>{prevLabel}</button>
    )}
    {pages.map((page) =>
      page.url && !page.current && !page.disabled ? (
        <a class="d-btn d-btn-outline d-join-item theme-bordered theme-label-bold" href={withAnchor(page.url)}>{page.label}</a>
      ) : (
        <button
          class:list={[
            "d-btn",
            "d-join-item",
            "theme-bordered",
            "theme-label-bold",
            page.current ? "d-btn-primary" : "d-btn-outline",
            { "d-btn-disabled": page.disabled },
          ]}
          type="button"
          aria-current={page.current ? "page" : undefined}
          disabled={page.disabled || page.current}
        >
          {page.label}
        </button>
      ),
    )}
    {next ? (
      <a class="d-btn d-btn-outline d-join-item theme-bordered theme-label-bold" href={next}>{nextLabel}</a>
    ) : (
      <button class="d-btn d-btn-outline d-join-item theme-bordered d-btn-disabled" type="button" disabled>{nextLabel}</button>
    )}
  </div>
</nav>
