---
interface Props {
  title: string;
  url: string;
  imageUrl?: string;
  imageAlt?: string;
  description?: string;
  meta?: string;
}

const { title, url, imageUrl, imageAlt = title, description, meta } = Astro.props;
---

<a href={url} class="d-card bg-base-100 theme-bordered theme-elevated plt-media-card plt-location-card">
  {
    imageUrl && (
      <figure class="plt-media-card__media">
        <img src={imageUrl} alt={imageAlt} loading="lazy" />
      </figure>
    )
  }
  <div class="d-card-body plt-media-card__body">
    <h2 class="d-card-title theme-headline-sm plt-media-card__title">{title}</h2>
    {meta && <p class="theme-meta plt-media-card__meta">{meta}</p>}
    {description && <p class="theme-meta plt-media-card__description">{description}</p>}
  </div>
</a>
