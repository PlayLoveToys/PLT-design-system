{% comment %}
  PLT Navbar renderer. Interactive slots provided by the platform.
  Behaviour (mobile toggle, mega menu) comes from <plt-navbar> in
  @playlovetoys/web-components; load plt-web-components.bundle.js once per page.
  A link with `columns` (MegaMenu contract) opens a mega menu panel.
{% endcomment %}
<plt-navbar>
<header class="d-navbar plt-navbar" data-plt-navbar>
  <div class="plt-navbar__inner">
    <div class="d-navbar-start gap-2">
      <button
        type="button"
        class="d-btn d-btn-ghost d-btn-square plt-navbar__menu-toggle"
        data-plt-navbar-toggle
        aria-expanded="false"
        aria-controls="plt-navbar-mobile"
        aria-label="Open menu"
      >
        <span aria-hidden="true">☰</span>
      </button>
      <a class="d-btn d-btn-ghost plt-navbar__brand" href="{{ home_url | default: '/' | escape }}" aria-label="{{ site_name | escape }}">
        {% if logo_url != blank %}
          <img src="{{ logo_url | escape }}" alt="{{ logo_alt | default: site_name | escape }}">
        {% else %}
          <span class="theme-headline-sm">{{ site_name | escape }}</span>
        {% endif %}
      </a>
    </div>

    <div class="d-navbar-center plt-navbar__links">
      <ul class="d-menu d-menu-horizontal px-0">
        {% for link in links %}
          <li>
            <a
              class="theme-label-bold"
              href="{{ link.url | escape }}"
              {% if link.current %}aria-current="page"{% endif %}
              {% if link.columns.size > 0 %}aria-haspopup="true" aria-expanded="false" aria-controls="plt-megamenu-{{ forloop.index0 }}"{% endif %}
            >{{ link.label | escape }}</a>
          </li>
        {% endfor %}
      </ul>
      {% for link in links %}
        {% if link.columns.size > 0 %}
          {% assign megamenu_id = 'plt-megamenu-' | append: forloop.index0 %}
          {% include 'megamenu', id: megamenu_id, label: link.label, columns: link.columns %}
        {% endif %}
      {% endfor %}
    </div>

    <div class="d-navbar-end plt-navbar__actions">
      {{ actions }}
    </div>
  </div>

  <div class="plt-navbar__mobile" id="plt-navbar-mobile" data-open="false" hidden>
    <ul class="d-menu w-full">
      {% for link in links %}
        <li>
          <a
            class="theme-label-bold"
            href="{{ link.url | escape }}"
            {% if link.current %}aria-current="page"{% endif %}
          >{{ link.label | escape }}</a>
          {% if link.columns.size > 0 %}
            <ul>
              {% for column in link.columns %}
                <li>
                  {% if column.url != blank %}<a href="{{ column.url | escape }}">{{ column.title | escape }}</a>{% else %}<span class="theme-label-bold">{{ column.title | escape }}</span>{% endif %}
                  {% if column.children.size > 0 %}
                    <ul>
                      {% for child in column.children %}
                        <li><a href="{{ child.url | escape }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.label | escape }}</a></li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
    <div class="plt-navbar__actions">
      {{ mobile_actions }}
    </div>
  </div>
</header>
</plt-navbar>
